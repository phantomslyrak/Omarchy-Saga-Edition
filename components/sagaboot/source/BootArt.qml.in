pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Window
import Quickshell

// Asset renderer only; no password input, clocks with invented values or services.
ShellRoot {
    Window {
        id: win
        visible: true; width: 2560; height: 1600; color: "#0d171b"
        property real u: height / 1024
        property bool prompt: false
        property int phase: 0
        function configureFrame(component) {component.unit=win.u;component.focused=true;component.reducedMotion=true}
        Image {
            anchors.fill: parent
            source: "file://@SAGA_HOME@/.local/share/omarchy-saga-edition/assets/lock/fjord-clean-no-logo-v1.png"
            fillMode: Image.Stretch
        }
        Rectangle {
            anchors.fill: parent; opacity: 0.25
            gradient: Gradient {
                GradientStop {position:0;color:"#38081113"}
                GradientStop {position:0.52;color:"#160b1315"}
                GradientStop {position:1;color:"#60080c0e"}
            }
        }
        Text {
            x:win.width*0.041;y:win.height*0.217
            text:"A CALMER MIND\nA STRONGER TOMORROW"
            color:"#ead6bc";font.family:"Liberation Serif";font.pixelSize:12*win.u
            font.letterSpacing:2.4*win.u;lineHeight:1.7
        }
        Rectangle {x:win.width*0.041;y:win.height*0.199;width:216*win.u;height:1;color:"#789b9789"}
        Rectangle {x:win.width*0.041;y:win.height*0.272;width:68*win.u;height:1;color:"#789b9789"}
        Item {
            x:win.width*0.0456;y:win.height*0.854;width:win.width*0.26;height:win.height*0.082
            Rectangle {width:1;height:parent.height;color:"#789b9789"}
            Text {x:23*win.u;text:"You have no enemies.\nNo one does.";color:"#ead6bc";font.family:"Liberation Serif";font.pixelSize:21*win.u;font.italic:true;lineHeight:1.3}
            Text {x:23*win.u;y:67*win.u;text:"— THORFINN";color:"#ead6bc";font.family:"Liberation Serif";font.pixelSize:12*win.u;font.letterSpacing:2*win.u}
        }
        Text {
            x:win.width*0.845;y:win.height*0.86;width:win.width*0.115
            text:"FAR LANDS\nQUIET SEAS\nCLEAR THOUGHTS";color:"#ead6bc"
            font.family:"Liberation Serif";font.pixelSize:12*win.u;font.letterSpacing:2.2*win.u
            horizontalAlignment:Text.AlignHCenter;lineHeight:1.8
        }
        Item {
            id: field
            visible:win.prompt
            x:(win.width-width)/2;y:win.height*0.774;width:win.width*0.26;height:56*win.u
            Rectangle {anchors.fill:parent;radius:height/2;color:"#dc242725";border.color:"#dfc9aa";border.width:1}
            Loader {
                x:-6*win.u;y:-6*win.u;width:field.width+12*win.u;height:field.height+12*win.u
                source:"file://@SAGA_HOME@/.config/omarchy/lock-designs/saga-runes-v1/NorthernFrame.qml"
                onLoaded: win.configureFrame(item)
            }
            Text {x:22*win.u;anchors.verticalCenter:parent.verticalCenter;text:"◇";font.pixelSize:24*win.u;color:"#ead6bc"}
        }
        Timer {
            interval:600;running:true;repeat:true
            onTriggered: {
                const dir="@SAGA_HOME@/.local/share/omarchy-saga-edition/releases/SagaBoot-v1.0/source/"
                if(win.phase===0) {
                    win.contentItem.grabToImage(function(r){if(!r.saveToFile(dir+"plain.png"))throw new Error("plain export failed");win.prompt=true;win.phase=1})
                } else if(win.phase===1) {
                    win.phase=2
                    win.contentItem.grabToImage(function(r){if(!r.saveToFile(dir+"prompt.png"))throw new Error("prompt export failed");console.log("SAGABOOT_ART_READY");Qt.quit()})
                }
            }
        }
    }
}
