+// A decoration must not turn an optional allocation failure into the fatal
+// assertion used by the compositor's normal work-buffer allocator. This FBO
+// is only the final target of a lock-only offscreen copy; it needs no stencil,
+// mirroring, or CPU readback. The normal renderer/allocator stays unchanged.
+class CSagaFramebuffer final : public IFramebuffer {
+  public:
+    CSagaFramebuffer() : IFramebuffer("Saga authenticated lock snapshot") {
+        ;
+    }
+    ~CSagaFramebuffer() override {
+        release();
+    }
+
+    void bind() override {
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_fbo);
+        Render::GL::g_pHyprOpenGL->setViewport(0, 0, m_size.x, m_size.y);
+    }
+    void release() override {
+        if (g_pCompositor && !g_pCompositor->m_isShuttingDown && Render::GL::g_pHyprOpenGL) {
+            Render::GL::g_pHyprOpenGL->makeEGLCurrent();
+            if (m_fbo)
+                glDeleteFramebuffers(1, &m_fbo);
+        }
+        m_fbo         = 0;
+        m_fbAllocated = false;
+        m_tex.reset();
+    }
+    bool readPixels(CHLBufferReference, uint32_t, uint32_t, uint32_t, uint32_t) override {
+        return false;
+    }
+    void addStencil(SP<ITexture>) override {
+        ;
+    }
+
+  protected:
+    bool internalAlloc(int w, int h, DRMFormat format) override {
+        if (format != DRM_FORMAT_ABGR8888)
+            return false;
+        Render::GL::g_pHyprOpenGL->makeEGLCurrent();
+        GLint oldFramebuffer = 0, oldTexture = 0;
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &oldFramebuffer);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &oldTexture);
+        const auto restore = CScopeGuard([&] {
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, oldFramebuffer);
+            glBindTexture(GL_TEXTURE_2D, oldTexture);
+        });
+        m_tex              = g_pHyprRenderer->createTexture(true);
+        m_tex->allocate({w, h}, format);
+        glBindTexture(GL_TEXTURE_2D, m_tex->m_texID);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glGenFramebuffers(1, &m_fbo);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_fbo);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_tex->m_texID, 0);
+        const auto status = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+        const auto error  = glGetError();
+        if (!m_fbo || !m_tex->m_texID || status != GL_FRAMEBUFFER_COMPLETE || error != GL_NO_ERROR) {
+            release();
+            Log::logger->log(Log::WARN, "Saga reveal skipped: optional framebuffer allocation failed");
+            return false;
+        }
+        return true;
+    }
+
+  private:
+    GLuint m_fbo = 0;
+};
+
+static std::optional<int> sagaRevealDuration() {
+    // No new service/config reload. A private per-user runtime file is the opt-in
+    // and kill switch. Nonblocking + NOFOLLOW prevents a FIFO/symlink blocking render.
+    const auto path = std::format("/run/user/{}/saga-desktop-reveal.enabled", getuid());
+    return SagaReveal::readDuration(path.c_str(), getuid());
+}
+
+void IHyprRenderer::clearSagaReveal() {
+    for (const auto& [id, reveal] : m_sagaReveals) {
+        if (auto monitor = reveal.monitor.lock())
+            damageMonitor(monitor);
+    }
+    m_sagaReveals.clear();
+    if (m_sagaRevealTimer)
+        m_sagaRevealTimer->updateTimeout(std::nullopt);
+}
+
+void IHyprRenderer::beginSagaReveal() {
+    clearSagaReveal();
+    static auto ANIMATIONS = CConfigValue<Config::INTEGER>("animations:enabled");
+    static auto XRAY       = CConfigValue<Config::INTEGER>("misc:session_lock_xray");
+    const auto  ms         = sagaRevealDuration();
+    if (!ms || !*ANIMATIONS || *XRAY || !g_pSessionLockManager->clientLocked() || g_pSessionLockManager->clientDenied())
+        return;
+
+    // Only snapshot the lock surface itself on a black, opaque primer. Never
+    // capture a workspace/framebuffer containing applications, or above-lock layers.
+    std::map<uint64_t, SSagaReveal> pending;
+    double                          remainingPixels = 16 * 1024 * 1024; // At most 64 MiB of optional RGBA8 covers.
+    for (const auto& monitor : State::monitorState()->monitors()) {
+        if (!monitor->m_enabled || !monitor->m_dpmsStatus)
+            continue;
+        const auto surface = g_pSessionLockManager->getSessionLockSurfaceForMonitor(monitor->m_id);
+        const auto tf      = monitor->m_imageDescription->value().transferFunction;
+        if (monitor->isMirror() || monitor->m_renderingActive || !surface || !surface->mapped || !surface->surface || !surface->surface->surface() ||
+            !surface->surface->surface()->m_current.texture || monitor->m_pixelSize.x <= 0 || monitor->m_pixelSize.y <= 0 ||
+            (tf != NColorManagement::CM_TRANSFER_FUNCTION_SRGB && tf != NColorManagement::CM_TRANSFER_FUNCTION_GAMMA22 && tf != NColorManagement::CM_TRANSFER_FUNCTION_BT1886)) {
+            Log::logger->log(Log::WARN, "Saga reveal skipped: unsupported/missing lock output");
+            return; // All eligible outputs or none; no partial multi-monitor claim.
+        }
+        const double pixels = monitor->m_pixelSize.x * monitor->m_pixelSize.y;
+        if (pixels > remainingPixels)
+            return;
+        remainingPixels -= pixels;
+        SP<IFramebuffer> frame = makeShared<CSagaFramebuffer>();
+        if (!frame || !frame->alloc(monitor->m_pixelSize.x, monitor->m_pixelSize.y, DRM_FORMAT_ABGR8888))
+            return;
+        frame->setImageDescription(monitor->workBufferImageDescription());
+        CRegion damage{0, 0, monitor->m_transformedSize.x, monitor->m_transformedSize.y};
+        if (!beginFullFakeRender(monitor, damage, frame))
+            return;
+        const bool wasSnapshot = m_bRenderingSnapshot;
+        m_bRenderingSnapshot   = true;
+        draw(CClearPassElement::SClearData{CHyprColor(0, 0, 0, 1)});
+        startRenderPass();
+        renderSessionLockSurface(surface, monitor, Time::steadyNow());
+        endRender();
+        m_bRenderingSnapshot = wasSnapshot;
+        if (!frame->getTexture())
+            return;
+        pending.emplace(monitor->m_id,
+                        SSagaReveal{monitor, frame, monitor->m_pixelSize, monitor->m_transformedSize, monitor->m_scale, static_cast<int>(monitor->m_transform), *ms, {}});
+    }
+    m_sagaReveals = std::move(pending);
+    if (m_sagaReveals.empty())
+        return;
+    // A missing/blanked output or a stopped rendering loop cannot retain a cover
+    // indefinitely. The watchdog also polls the kill switch without needing input.
+    m_sagaRevealDeadline = Time::steadyNow() + std::chrono::milliseconds(1500);
+    if (!m_sagaRevealTimer) {
+        m_sagaRevealTimer = makeShared<CEventLoopTimer>(std::nullopt, [this](auto, void*) { tickSagaReveal(); }, nullptr);
+        g_pEventLoopManager->addTimer(m_sagaRevealTimer);
+    }
+    m_sagaRevealTimer->updateTimeout(std::chrono::milliseconds(1));
+    Log::logger->log(Log::DEBUG, "Saga reveal armed: {} outputs, {} ms", m_sagaReveals.size(), *ms);
+}
+
+void IHyprRenderer::tickSagaReveal() {
+    static auto ANIMATIONS = CConfigValue<Config::INTEGER>("animations:enabled");
+    if (!sagaRevealDuration() || !*ANIMATIONS || g_pSessionLockManager->isSessionLocked() || Time::steadyNow() >= m_sagaRevealDeadline) {
+        clearSagaReveal();
+        return;
+    }
+    for (const auto& [id, reveal] : m_sagaReveals) {
+        if (auto monitor = reveal.monitor.lock()) {
+            damageMonitor(monitor);
+            monitor->scheduleFrame();
+        }
+    }
+    if (!m_sagaReveals.empty())
+        m_sagaRevealTimer->updateTimeout(std::chrono::milliseconds(8));
+}
+
+bool IHyprRenderer::sagaRevealPending(PHLMONITOR monitor) {
+    if (m_sagaReveals.empty())
+        return false;
+    static auto ANIMATIONS = CConfigValue<Config::INTEGER>("animations:enabled");
+    if (g_pSessionLockManager->isSessionLocked() || !sagaRevealDuration() || !*ANIMATIONS || Time::steadyNow() >= m_sagaRevealDeadline) {
+        clearSagaReveal();
+        return false;
+    }
+    const auto it = m_sagaReveals.find(monitor->m_id);
+    if (it == m_sagaReveals.end())
+        return false;
+    const auto& r = it->second;
+    if (r.monitor.lock() != monitor || r.pixelSize != monitor->m_pixelSize || r.transformedSize != monitor->m_transformedSize || r.scale != monitor->m_scale ||
+        r.transform != static_cast<int>(monitor->m_transform) || monitor->isMirror()) {
+        clearSagaReveal(); // Hotplug/mode/transform changes: prefer an ordinary desktop.
+        return false;
+    }
+    return true;
+}
+
+void IHyprRenderer::renderSagaReveal(PHLMONITOR monitor, const Time::steady_tp& now) {
+    if (!sagaRevealPending(monitor))
+        return;
+    auto&       reveal = m_sagaReveals.at(monitor->m_id);
+    const float alpha  = reveal.timeline.alpha(now, reveal.durationMs);
+    if (alpha <= 0.F) {
+        m_sagaReveals.erase(monitor->m_id);
+        return;
+    }
+    CTexPassElement::SRenderData data;
+    data.tex          = reveal.frame->getTexture();
+    data.box          = {0, 0, monitor->m_transformedSize.x, monitor->m_transformedSize.y};
+    data.a            = alpha;
+    data.flipEndFrame = true; // Match Hyprland's existing framebuffer fadeout path.
+    m_renderPass.add(makeUnique<CTexPassElement>(std::move(data)));
+}
