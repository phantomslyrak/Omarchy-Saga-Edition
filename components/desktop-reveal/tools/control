#!/usr/bin/env python3
"""Opt-in for the patched compositor. Does not install, unlock or restart anything."""
import argparse
import os
from pathlib import Path
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('action', choices=['enable', 'disable', 'status', 'reduced-motion'])
parser.add_argument('--ms', type=int, default=700, help='reveal duration, 350–700 ms (default: 700, preferred on RedmiBook)')
args = parser.parse_args()
runtime = Path('/run/user') / str(os.getuid())
flag = runtime / 'saga-desktop-reveal.enabled'
if args.action in ('disable', 'reduced-motion'):
    flag.unlink(missing_ok=True)
    print('Reveal disabled. A patched compositor drops the cover on its next frame/timer tick.')
elif args.action == 'enable':
    if not 350 <= args.ms <= 700:
        parser.error('--ms must be between 350 and 700')
    st = runtime.stat()
    if st.st_uid != os.getuid() or st.st_mode & 0o022:
        parser.error('runtime directory owner/permissions are unsafe')
    fd, temporary = tempfile.mkstemp(prefix='.saga-reveal-', dir=runtime)
    try:
        with os.fdopen(fd, 'w') as out:
            out.write(f'{args.ms}\n')
        os.replace(temporary, flag)
    finally:
        Path(temporary).unlink(missing_ok=True)
    print(f'Requested {args.ms} ms reveal. Requires the patched Hyprland; stock Hyprland ignores this flag.')
else:
    print('Requested: ' + (flag.read_text().strip() + ' ms' if flag.is_file() else 'disabled'))
    print('Backend: not probed; this tool only controls the opt-in flag.')
